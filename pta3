题目：输入5个整数存入一维数组，求数组里面最大值。

#include <stdio.h>
int main(void)
{
    int a[5], i, max;
    for(i = 0; i < 5; i++)
    {
        scanf("%d", &a[i]);
    }
    max = a[0];
    for(i = 1; i < 5; i++)
    {
        if(a[i] > max)
        {
            max = a[i];
        }
    }
    printf("max=%d\n", max);
    return 0;
}
