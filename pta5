题目：写函数  int isPrime(int x)  判断一个整数是不是素数。主函数输入一个数，输出结果。

#include <stdio.h>
int isPrime(int x)
{
    int i;
    if(x <= 1)
        return 0;
    for(i = 2; i*i <= x; i++)
    {
        if(x % i == 0)
            return 0;
    }
    return 1;
}

int main(void)
{
    int n;
    scanf("%d", &n);
    if(isPrime(n))
    {
        printf("%d是素数\n", n);
    }
    else
    {
        printf("%d不是素数\n", n);
    }
    return 0;
}
